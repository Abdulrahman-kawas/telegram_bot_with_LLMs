# Copy to .env and fill in. The bot also reads the free-llm keys from free-llms/.env.

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# LINE Messaging API (optional — the LINE channel only starts when both are set).
# Create a channel at https://developers.line.biz, then point its webhook to
# https://<your-public-url>/line/webhook (e.g. a cloudflared tunnel to LINE_PORT).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_PORT=8080

# Optional: where users/assignments are stored (default: ./data.json next to this file)
# UNI_BOT_DATA=./data.json
